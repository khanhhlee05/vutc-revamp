# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string (Neon in production, local Postgres in dev)
DATABASE_URL=postgres://postgres@127.0.0.1:5433/vutc_dev

# better-auth: random 32+ byte secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Public origin of the app, no trailing slash
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend API key for transactional email. Leave empty in dev to log emails to the console.
RESEND_API_KEY=
EMAIL_FROM="VUTC Events <events@vutc.com>"
EVENTS_INBOX=events@vutc.com

# Cloudflare Turnstile (public request form). Leave empty in dev to skip the check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shared secret for /api/cron/* endpoints
CRON_SECRET=change-me
